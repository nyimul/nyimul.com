# Copy to .env.local for local dev (gitignored). In production, add these in
# Vercel > Project > Settings > Environment Variables.
#
# NEVER prefix a secret with NEXT_PUBLIC_ : that prefix bundles the value into the browser JS.

# New, wedding-only Supabase project (Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: site-wide password gate for /hridee (see WEDDING.md > Security > Password gate)
WEDDING_PASSWORD=

# Password for /hridee/admin (if you choose the admin-page option)
ADMIN_PASSWORD=

# Optional: Google Sheets sync (service account JSON, base64-encoded) and the target sheet id
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SHEET_ID=
