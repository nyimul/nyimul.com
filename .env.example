# Copy to .env.local for local dev (gitignored). In production, add these in
# Vercel > Project > Settings > Environment Variables.
#
# NEVER prefix a secret with NEXT_PUBLIC_ : that prefix bundles the value into the browser JS.

# New, wedding-only Supabase project.
#   SUPABASE_URL         Project Settings > Data API > Project URL (https://<ref>.supabase.co)
#   SUPABASE_SECRET_KEY  Project Settings > API Keys > Secret keys (starts with sb_secret_).
#                        Not the publishable key, and not a legacy service_role key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# The password printed on the invitations. Guests type it at /hridee/enter before the name lookup.
# Case, spaces and punctuation are ignored when comparing.
WEDDING_PASSWORD=

# Signs the session cookie. 32+ random characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs every guest out.
WEDDING_SESSION_SECRET=

# Local preview only: 1 = use the fake guest list in app/(wedding)/_lib/store/demo.ts instead of
# Supabase. Never set this in Vercel: on any Vercel deployment the wedding pages throw an error if it is set.
WEDDING_DEMO_DATA=

# Shared with the family's Google Sheet (scripts/wedding-sheet.gs), which sends it to
# POST /hridee/sync. Anyone holding it can read every RSVP and rewrite the guest list.
# 32+ random characters; generate with the same command as WEDDING_SESSION_SECRET.
WEDDING_SHEET_SECRET=
